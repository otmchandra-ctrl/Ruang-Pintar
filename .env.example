# Ruang Pintar Environment Baseline
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Database (Baseline SQLite - Phase 02 Foundation)
DATABASE_URL="file:./data/ruang-pintar.db"

# Supabase PostgreSQL (server only; use transaction pooler for Vercel runtime)
# DATABASE_URL="postgresql://...pooler...:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://...direct-or-session-pooler.../postgres"
# For one-time import only; never commit real connection strings.
# SOURCE_DATABASE_URL="file:./data/ruang-pintar.db"
# TARGET_DATABASE_URL="postgresql://...direct-or-session-pooler.../postgres"

# Storage
STORAGE_LOCAL_ROOT="./data/storage"
# Set SUPABASE after creating a private bucket named below. Service role key is server-only.
STORAGE_PROVIDER="LOCAL"
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_STORAGE_BUCKET="ruang-pintar-private"

# Google OAuth MVP (server-only secret)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
GOOGLE_OAUTH_STATE_SECRET=""
